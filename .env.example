# =============================================================================
# PocketPlot — environment template
# Copy to `.env` and fill in the real values. Never commit a real .env.
# =============================================================================

# ---- Flask ----
# A long random string. Used to sign session cookies and magic-link tokens.
# Generate:  python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET=change-me-to-a-long-random-string

# ---- Stripe (live mode) ----
# When these are blank, the app starts in MOCK BILLING MODE — Stripe events
# are simulated. You can sign up, request a magic link from /login, sign in
# at /me, upgrade to Pro (mock checkout), and cancel — all without a real
# Stripe account.
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# After creating the PocketPlot Pro product + $4.99/month price, paste the
# price id here.
STRIPE_PRICE_ID=
# After creating the webhook endpoint, paste the signing secret here.
# In local dev, run `stripe listen --forward-to localhost:5000/webhook/stripe`
# and use the whsec_... it prints.
STRIPE_WEBHOOK_SECRET=

# ---- Email (SMTP) ----
# Leave blank to save emails to ./outbox/ as .eml files (great for local dev).
# For real delivery, set all four:
POCKETPLOT_SMTP_HOST=
POCKETPLOT_SMTP_PORT=587
POCKETPLOT_SMTP_USER=
POCKETPLOT_SMTP_PASS=
POCKETPLOT_FROM_EMAIL=hello@pocketplot.example.com

# ---- Site ----
# The publicly visible URL of the app. Used in Stripe success/cancel URLs
# and in the "manage your account" link in every email.
POCKETPLOT_SITE_URL=https://pocketplot.example.com

# ---- Scheduling ----
# UTC hour to deliver the nightly story. 20 = 8 pm. Adjust for your audience.
POCKETPLOT_DELIVERY_HOUR=20

# ---- Admin ----
# Password for /admin. CHANGE this before any deployment.
POCKETPLOT_ADMIN_PASSWORD=letmein

# ---- Database & file storage ----
# Where SQLite + audio MP3s + drawing uploads live. Default: project root.
# For Docker, override to /app/data and /app/audio respectively.
POCKETPLOT_DB_PATH=
POCKETPLOT_OUTBOX_DIR=
POCKETPLOT_AUDIO_DIR=

# ---- TTS (Story Time audio) ----
# If you don't have pyttsx3 + espeak-ng installed, audio is gracefully
# skipped. Install with:
#   apt-get install espeak-ng
#   pip install pyttsx3
# Audio files are 4-6MB each in default espeak encoding. For smaller files,
# consider swapping pyttsx3 for a higher-quality TTS later.

# ---- Audio access (security) ----
# By default, audio files + drawing uploads are accessible only to the
# subscriber who owns them. To make audio PUBLIC (any link clicker can
# listen — useful for social sharing), set this to true.
POCKETPLOT_PUBLIC_AUDIO=
