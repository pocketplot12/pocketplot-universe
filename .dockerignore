# =============================================================================
# Files NOT to copy into the Docker image
# Keeps the image small and keeps secrets out of layer history.
# =============================================================================

# Local data — volumes mount over /app/data and /app/outbox in the container
*.db
*.db-journal
*.sqlite
*.sqlite3
outbox/
data/
audio/
venv/
.venv/
__pycache__/
*.pyc
*.pyo

# Secrets — load via .env at runtime, never bake into layers
.env
.env.*
!.env.example
secrets/

# Git / docs / scripts that don't need to be in the image
.git/
.gitignore
*.md
LICENSE
.editorconfig
.dockerignore
Dockerfile
docker-compose.yml
